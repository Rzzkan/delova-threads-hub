# ===== Wajib =====
# String acak panjang (min 32 karakter). Dipakai untuk enkripsi token Threads & sesi login.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Akun admin pertama (dibuat otomatis saat pertama kali jalan jika belum ada user)
ADMIN_EMAIL=admin@delova.id
ADMIN_PASSWORD=

# URL publik aplikasi. Untuk go-live Threads WAJIB https (Meta menolak redirect http).
APP_BASE_URL=http://localhost:3000
PORT=3000

# ===== Claude (fitur AI di dalam dashboard) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ===== Threads / Meta =====
# Biarkan true selama belum punya kredensial. Mode simulasi tidak memposting ke Threads asli.
THREADS_DRY_RUN=true
THREADS_APP_ID=
THREADS_APP_SECRET=

# Lokasi database (SQLite). Pastikan folder ini ikut di-backup.
# (Di Docker sudah diatur otomatis ke volume /data, abaikan baris ini.)
DATA_DIR=./data

# ===== Khusus deploy Docker di VPS (lihat deploy/DEPLOY.md) =====
# Port lokal untuk reverse proxy; ubah jika 3100 sudah dipakai aplikasi lain.
# HUB_PORT=3100
# Jumlah lapisan reverse proxy di depan aplikasi (docker-compose.yml sudah mengisi 1).
# TRUST_PROXY=1
